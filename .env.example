ENVIRONMENT=dev
# Use a unique name and port for every project deployed on the same VPS.
COMPOSE_PROJECT_NAME=comynity
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

SECRET_KEY=replace-me
DEBUG=True

# PostgreSQL must have the PostGIS extension enabled. Local development also
# requires native GDAL/GEOS libraries; the Docker image includes them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comynity
REDIS_URL=redis://default:password@localhost:6379/0

# Required only when running GeoDjango directly on Windows. Adjust the folder
# and GDAL DLL version to match your OSGeo4W/QGIS installation.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MSG_AUTH_KEY=
MSG_WIDGET_ID=
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
MSG91_TIMEOUT_SECONDS=10

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_UPDATE_LAST_LOGIN=False
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=
JWT_AUTH_HEADER_TYPES=Bearer

OTP_SEND_RATE=5/hour
OTP_RESEND_RATE=5/hour
OTP_VERIFY_RATE=20/hour
TOKEN_REFRESH_RATE=30/hour
DB_CONN_MAX_AGE=60
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
LOG_LEVEL=INFO

# Cloudflare R2 media storage. Keep disabled for local filesystem storage.
R2_ENABLED=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Cloudflare bucket Settings > Public Development URL (full URL is accepted).
R2_PUBLIC_DEVELOPMENT_URL=https://pub-YOUR_BUCKET_ID.r2.dev
# Hostname only, without https://. Set for a public r2.dev/custom domain.
R2_CUSTOM_DOMAIN=
R2_LOCATION=media
# True for private buckets (signed URLs); False for public/custom domains.
R2_QUERYSTRING_AUTH=True
R2_QUERYSTRING_EXPIRE=3600
